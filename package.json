{
  "name": "fix-it-garage",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Fix It Garage - a cozy 3D car repair workshop game for the web",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:web": "tsc --noEmit && vite build --mode web",
    "build:gd": "tsc --noEmit && vite build --mode gd",
    "build:gamepix": "tsc --noEmit && vite build --mode gamepix",
    "build:playgama": "tsc --noEmit && vite build --mode playgama",
    "build:gamemonetize": "tsc --noEmit && vite build --mode gamemonetize",
    "build:y8": "tsc --noEmit && vite build --mode y8",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "test:e2e:gamemonetize": "playwright test -c playwright.gamemonetize.config.ts --trace off",
    "test:e2e:y8": "playwright test -c playwright.y8.config.ts --trace off",
    "assets": "node scripts/assets.mjs",
    "validate:jobs": "tsx scripts/validate-jobs.ts",
    "check:i18n": "node scripts/check-i18n.mjs",
    "submission": "node scripts/submission/build.mjs",
    "submission:check": "node scripts/submission/check.mjs",
    "submission:web": "npm run build:web && node scripts/web/zip.mjs",
    "check:web": "node scripts/web/check.mjs",
    "store:web": "node scripts/web/store.mjs",
    "submission:playgama": "npm run build:playgama && node scripts/playgama/zip.mjs",
    "check:playgama": "node scripts/playgama/check.mjs",
    "test:playgama": "node scripts/playgama/test.mjs",
    "qa:playgama": "node scripts/playgama/qa.mjs",
    "submission:gamemonetize": "npm run build:gamemonetize && node scripts/gamemonetize/zip.mjs",
    "check:gamemonetize": "node scripts/gamemonetize/check.mjs",
    "images:gamemonetize": "tsx scripts/gamemonetize/images.ts",
    "submission:y8": "npm run build:y8 && node scripts/y8/zip.mjs",
    "check:y8": "node scripts/y8/check.mjs",
    "media:y8": "tsx scripts/y8/media.ts",
    "covers": "tsx scripts/submission/covers.ts",
    "trailer": "tsx scripts/submission/trailer.ts",
    "preview:shots": "tsx scripts/preview-shots.ts",
    "preview:video": "tsx scripts/preview-video.ts"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.6",
    "@types/three": "0.170.0",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "meshoptimizer": "^1.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
